{
  "title": "AgentCraft blueprint v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "format": {
      "type": "string",
      "const": "agentcraft-blueprint"
    },
    "version": {
      "type": "number",
      "const": 1
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "description": {
      "type": "string",
      "maxLength": 1000
    },
    "size": {
      "type": "array",
      "prefixItems": [
        {
          "type": "integer",
          "minimum": 1,
          "maximum": 256
        },
        {
          "type": "integer",
          "minimum": 1,
          "maximum": 256
        },
        {
          "type": "integer",
          "minimum": 1,
          "maximum": 256
        }
      ],
      "items": false,
      "minItems": 3,
      "maxItems": 3
    },
    "palette": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[A-Za-z0-9]$"
      },
      "additionalProperties": {
        "type": "string",
        "minLength": 3,
        "maxLength": 256
      },
      "description": "letter -> block with optional states, e.g. \"minecraft:oak_stairs[facing=north,half=bottom]\"; \"_\" is always air"
    },
    "modules": {
      "minItems": 1,
      "maxItems": 32,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9_-]{1,32}$"
          },
          "name": {
            "description": "Italian, for people, e.g. \"Fondamenta\"",
            "type": "string",
            "maxLength": 64
          },
          "dependsOn": {
            "default": [],
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "ops": {
            "minItems": 1,
            "maxItems": 5000,
            "type": "array",
            "items": {
              "oneOf": [
                {
                  "type": "object",
                  "properties": {
                    "op": {
                      "type": "string",
                      "const": "set"
                    },
                    "at": {
                      "type": "array",
                      "prefixItems": [
                        {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 9007199254740991
                        },
                        {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 9007199254740991
                        },
                        {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 9007199254740991
                        }
                      ],
                      "items": false,
                      "minItems": 3,
                      "maxItems": 3
                    },
                    "block": {
                      "type": "string",
                      "pattern": "^[A-Za-z0-9]$"
                    }
                  },
                  "required": [
                    "op",
                    "at",
                    "block"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "op": {
                      "type": "string",
                      "const": "fill"
                    },
                    "from": {
                      "type": "array",
                      "prefixItems": [
                        {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 9007199254740991
                        },
                        {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 9007199254740991
                        },
                        {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 9007199254740991
                        }
                      ],
                      "items": false,
                      "minItems": 3,
                      "maxItems": 3
                    },
                    "to": {
                      "type": "array",
                      "prefixItems": [
                        {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 9007199254740991
                        },
                        {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 9007199254740991
                        },
                        {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 9007199254740991
                        }
                      ],
                      "items": false,
                      "minItems": 3,
                      "maxItems": 3
                    },
                    "block": {
                      "type": "string",
                      "pattern": "^[A-Za-z0-9]$"
                    },
                    "mode": {
                      "default": "solid",
                      "description": "hollow = box with air inside; walls = the four sides only; outline = edges only",
                      "type": "string",
                      "enum": [
                        "solid",
                        "hollow",
                        "walls",
                        "outline"
                      ]
                    }
                  },
                  "required": [
                    "op",
                    "from",
                    "to",
                    "block",
                    "mode"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "op": {
                      "type": "string",
                      "const": "line"
                    },
                    "from": {
                      "type": "array",
                      "prefixItems": [
                        {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 9007199254740991
                        },
                        {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 9007199254740991
                        },
                        {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 9007199254740991
                        }
                      ],
                      "items": false,
                      "minItems": 3,
                      "maxItems": 3
                    },
                    "to": {
                      "type": "array",
                      "prefixItems": [
                        {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 9007199254740991
                        },
                        {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 9007199254740991
                        },
                        {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 9007199254740991
                        }
                      ],
                      "items": false,
                      "minItems": 3,
                      "maxItems": 3
                    },
                    "block": {
                      "type": "string",
                      "pattern": "^[A-Za-z0-9]$"
                    }
                  },
                  "required": [
                    "op",
                    "from",
                    "to",
                    "block"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "op": {
                      "type": "string",
                      "const": "layers"
                    },
                    "origin": {
                      "type": "array",
                      "prefixItems": [
                        {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 9007199254740991
                        },
                        {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 9007199254740991
                        },
                        {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 9007199254740991
                        }
                      ],
                      "items": false,
                      "minItems": 3,
                      "maxItems": 3
                    },
                    "rows": {
                      "minItems": 1,
                      "maxItems": 256,
                      "type": "array",
                      "items": {
                        "type": "array",
                        "items": {
                          "type": "string",
                          "maxLength": 256
                        }
                      },
                      "description": "rows[y][z] is a string, one character per x; \".\" or \" \" = leave as it is, \"_\" = air"
                    }
                  },
                  "required": [
                    "op",
                    "origin",
                    "rows"
                  ],
                  "additionalProperties": false
                }
              ]
            }
          }
        },
        "required": [
          "id",
          "dependsOn",
          "ops"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "format",
    "version",
    "name",
    "size",
    "palette",
    "modules"
  ],
  "additionalProperties": false
}
