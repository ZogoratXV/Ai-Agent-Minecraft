{
  "name": "agentcraft-server",
  "private": true,
  "type": "module",
  "workspaces": [
    "protocol",
    "foreman"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "npm run test --workspaces",
    "typecheck": "npm run typecheck --workspaces",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "gen:protocol": "npm run gen --workspace protocol",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run check --workspace protocol && npm test"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "eslint": "^10.13.0",
    "prettier": "~3.9.10",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^5.0.5"
  }
}
